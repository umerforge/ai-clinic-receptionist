    {
      "parameters": {
        "jsCode": "const doctors = $('Doctor found? (check)').all().map(i => i.json);\nconst fmt = s => new Date(s).toLocaleString('en-GB', {timeZone: 'Asia/Karachi', weekday: 'short', day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit', hour12: true});\nconst perDoctor = doctors.length > 1 ? 3 : 10;\nconst used = {};\nlet slots = [];\nfor (const item of $input.all()) {\n  const r = item.json;\n  if (!r.slot_start) continue;\n  let idx = 0;\n  const p = item.pairedItem;\n  if (typeof p === 'number') idx = p; else if (p && typeof p.item === 'number') idx = p.item;\n  const d = doctors[idx] || doctors[0] || {};\n  const name = d.full_name || null;\n  used[name] = (used[name] || 0) + 1;\n  if (used[name] > perDoctor) continue;\n  slots.push({ doctor: name, start: r.slot_start, label: fmt(r.slot_start) });\n}\nslots.sort((a, b) => new Date(a.start) - new Date(b.start));\nconst count = slots.length;\nslots = slots.slice(0, 12);\nreturn [{ json: { success: true, count, slots } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1200, -224],
