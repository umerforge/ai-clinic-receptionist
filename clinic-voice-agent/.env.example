# LiveKit project (required)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# LLM (required)
GROQ_API_KEY=

# Deepgram Nova-3 STT plus Aura TTS, English only.
DEEPGRAM_API_KEY=
# Deepgram Aura voice model.
TTS_MODEL=aura-2-thalia-en

# Hospital ambience plus occasional typing while the agent checks tools.
# The MP3 loops on the same voice track as the agent.
ENABLE_BACKGROUND_AUDIO=true
BACKGROUND_AMBIENCE_FILE=assets/hospital-ambience.mp3
# Console/local monitoring volume.
BACKGROUND_AMBIENCE_VOLUME=0.3
# Volume mixed under the agent voice on real calls.
BACKGROUND_MIX_VOLUME=0.12
BACKGROUND_THINKING_VOLUME=0.18
BACKGROUND_THINKING_PROBABILITY=0.55

# n8n webhook base URL, without a trailing slash (required)
N8N_WEBHOOK_BASE_URL=
# Shared secret sent as X-Webhook-Secret (required)
N8N_WEBHOOK_SECRET=

# Groq model (optional, default shown; gpt-oss-120b is a stronger alternative)
GROQ_MODEL=openai/gpt-oss-20b

# Caller id fallback for browser testing, e.g. +923001112233 (optional)
TEST_PHONE=
# Total n8n request timeout in seconds (optional, default shown)
WEBHOOK_TIMEOUT_SEC=8
