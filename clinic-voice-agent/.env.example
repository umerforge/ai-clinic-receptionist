# LiveKit project (required)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# LLM (required)
GROQ_API_KEY=

# Deepgram Nova-3 STT plus Aura TTS, English only.
DEEPGRAM_API_KEY=
# Deepgram Aura voice model.
TTS_MODEL=aura-2-thalia-en

# Full n8n production webhook URL, without a trailing slash (required)
N8N_WEBHOOK_URL=https:
# Shared secret sent as the x-webhook-secret header (required)
N8N_WEBHOOK_SECRET=

# Groq primary model and fallback model (optional, defaults shown)
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODEL=qwen/qwen3.8-27b

# Caller id fallback for browser testing, e.g. +923001112233 (optional)
TEST_PHONE=
# Total n8n request timeout in seconds (optional, default shown)
WEBHOOK_TIMEOUT_SEC=8
