# LiveKit project (required)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Speech and language providers (required)
DEEPGRAM_API_KEY=
GROQ_API_KEY=

# n8n webhook base URL, without a trailing slash (required)
N8N_WEBHOOK_BASE_URL=
# Shared secret sent as X-Webhook-Secret (required)
N8N_WEBHOOK_SECRET=

# Groq model (optional, default shown; gpt-oss-120b is a stronger alternative)
GROQ_MODEL=openai/gpt-oss-20b
# Deepgram Aura voice (optional, default shown)
TTS_MODEL=aura-2-thalia-en

# Caller id fallback for browser testing, e.g. +923001112233 (optional)
TEST_PHONE=
# Total n8n request timeout in seconds (optional, default shown)
WEBHOOK_TIMEOUT_SEC=8
