# LiveKit project (required)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# LLM (required)
GROQ_API_KEY=

# Speech provider: auto, soniox, or deepgram.
# auto uses Soniox when SONIOX_API_KEY is set, otherwise Deepgram English-only.
SPEECH_PROVIDER=auto

# Soniox gives real-time Urdu + English code-switching for both STT and TTS.
# Required for Urdu and mixed-language calls.
SONIOX_API_KEY=
SONIOX_STT_MODEL=stt-rt-v5
SONIOX_TTS_MODEL=tts-rt-v2
# Voice names are listed at https://soniox.com/docs/tts/voices
SONIOX_VOICE=Maya
# Urdu and English language hints for STT. Keep ur first for Urdu-first callers.
STT_LANGUAGE_HINTS=ur,en

# Deepgram is the English-only fallback when Soniox is not configured.
DEEPGRAM_API_KEY=
# Deepgram Aura voice used only in fallback mode.
TTS_MODEL=aura-2-thalia-en

# Speaking rate for Soniox TTS, 0.7 to 1.3 (1.0 is natural).
TTS_SPEED=1.0

# Endpointing: lower delay is faster, higher is more tolerant of pauses.
SONIOX_ENDPOINT_DELAY_MS=800
SONIOX_ENDPOINT_SENSITIVITY=0.3
SONIOX_ENDPOINT_LATENCY_LEVEL=1

# Hospital ambience plus occasional typing while the agent checks tools.
# The MP3 is looped. Replace assets/hospital-ambience.mp3 to change the ambience.
ENABLE_BACKGROUND_AUDIO=true
BACKGROUND_AMBIENCE_FILE=assets/hospital-ambience.mp3
BACKGROUND_AMBIENCE_VOLUME=0.12
BACKGROUND_THINKING_VOLUME=0.18
BACKGROUND_THINKING_PROBABILITY=0.55

# n8n webhook base URL, without a trailing slash (required)
N8N_WEBHOOK_BASE_URL=
# Shared secret sent as X-Webhook-Secret (required)
N8N_WEBHOOK_SECRET=

# Groq model (optional, default shown; gpt-oss-120b is a stronger alternative)
GROQ_MODEL=openai/gpt-oss-20b

# Caller id fallback for browser testing, e.g. +923001112233 (optional)
TEST_PHONE=
# Total n8n request timeout in seconds (optional, default shown)
WEBHOOK_TIMEOUT_SEC=8
